  * @brief          : Step 4 - Full Adaptive Slip-Compensated Kalman Filter (EKF)
  * @team           : Kalman X (TerraNav)
  ******************************************************************************
  */
/* USER CODE END Header */

/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846f
#endif

/* Physical Constants */
#define WHEEL_RADIUS_M          0.033f   // 33 mm radius (66 mm wheel)
#define ENCODER_PPR             20.0f    // 20 pulses per revolution slotted disc
#define MPU6050_ADDR            (0x68 << 1)
#define SLIP_THRESHOLD_MPS      0.25f    // 25 cm/s discrepancy triggers slip

/* Nominal vs Inflated Measurement Noise Covariance */
#define R_ENC_NOMINAL           0.02f    // Normal traction variance
#define R_ENC_INFLATED          2.00f    // 100x inflated variance during slip (Ignores wheels)

/* Peripherals */
I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef huart2;

/* Global Tick Counters (Updated via EXTI ISR on PC0 & PC1) */
volatile uint32_t left_ticks_total  = 0;
volatile uint32_t right_ticks_total = 0;

/* Calibrated Gyro & Accel Offsets */
float bias_gz = 0.0f;
float bias_ax = 0.0f;

/* =========================================================================
 * KALMAN FILTER STATE VARIABLES
 * ========================================================================= */
// Raw Dead Reckoning (The Unfiltered Baseline - Will drift during slip!)
float raw_x_m = 0.0f;

// Kalman X Estimated State (Slip-Compensated!)
float ekf_x_m   = 0.0f;
float ekf_v_mps = 0.0f;
float P_v       = 0.1f;  // Velocity error covariance
float heading_rad = 0.0f;

/* Private function prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_I2C1_Init(void);

int __io_putchar(int ch) {
    HAL_UART_Transmit(&huart2, (uint8_t *)&ch, 1, 10);
    return ch;
}

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();

  printf("\r\n====================================================================\r\n");
  printf("   KALMAN X: STEP 4 - ADAPTIVE SLIP-COMPENSATED KALMAN FILTER (EKF) \r\n");
  printf("====================================================================\r\n");

  // 1. Wake up MPU-6050
  uint8_t pwr = 0x01;
  HAL_I2C_Mem_Write(&hi2c1, MPU6050_ADDR, 0x6B, 1, &pwr, 1, 100);
  HAL_Delay(50);

  // 2. Set DLPF to ~42 Hz to filter mechanical motor vibration
  uint8_t dlpf = 0x03;
  HAL_I2C_Mem_Write(&hi2c1, MPU6050_ADDR, 0x1A, 1, &dlpf, 1, 100);

  // 3. Automated 2-second Gyro & Accel Calibration on Startup
  printf("[CALIB] Keep rover completely still on floor for 2 seconds...\r\n");
  float sum_gz = 0.0f;
  float sum_ax = 0.0f;
  const int SAMPLES = 200;

  for (int i = 0; i < SAMPLES; i++) {
      uint8_t buf[14];
      if (HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR, 0x3B, 1, buf, 14, 100) == HAL_OK) {
          int16_t raw_ax = (int16_t)((buf[0] << 8) | buf[1]);
          int16_t raw_gz = (int16_t)((buf[12] << 8) | buf[13]);
          sum_ax += (float)raw_ax * (9.80665f / 16384.0f);
          sum_gz += (float)raw_gz;
      }
      HAL_Delay(10);
  }

  bias_ax = sum_ax / SAMPLES;
  bias_gz = (sum_gz / SAMPLES) * (3.14159f / (180.0f * 131.0f));
  printf("[OK] Calibration complete! Ax_bias = %d cm/s2 | Gz_bias = %d mrad/s\r\n\r\n",
         (int)(bias_ax * 100.0f), (int)(bias_gz * 1000.0f));
  printf("WATCH: Compare RAW_X (drifting baseline) vs EKF_X (Kalman protected)!\r\n");
  printf("--------------------------------------------------------------------\r\n");

  uint32_t last_left_ticks  = 0;
  uint32_t last_right_ticks = 0;

  const float METERS_PER_TICK = (2.0f * M_PI * WHEEL_RADIUS_M) / ENCODER_PPR;
  const float DT = 0.1f; // 100ms time step

  /* Infinite loop at 10 Hz */
  while (1)
  {
    // -------------------------------------------------------------
    // A. SENSOR READS (IMU & ENCODERS)
    // -------------------------------------------------------------
    float accel_x_mps2 = 0.0f;
    uint8_t imu_buf[14];

    if (HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR, 0x3B, 1, imu_buf, 14, 100) == HAL_OK) {
        int16_t raw_ax = (int16_t)((imu_buf[0] << 8) | imu_buf[1]);
        int16_t raw_gz = (int16_t)((imu_buf[12] << 8) | imu_buf[13]);

        accel_x_mps2 = ((float)raw_ax * (9.80665f / 16384.0f)) - bias_ax;
        float gz_cal = ((float)raw_gz * (3.14159f / (180.0f * 131.0f))) - bias_gz;

        heading_rad += gz_cal * DT;
        if (heading_rad > M_PI)  heading_rad -= (2.0f * M_PI);
        if (heading_rad < -M_PI) heading_rad += (2.0f * M_PI);
    }

    uint32_t cur_left  = left_ticks_total;
    uint32_t cur_right = right_ticks_total;

    uint32_t delta_left  = cur_left - last_left_ticks;
    uint32_t delta_right = cur_right - last_right_ticks;

    last_left_ticks  = cur_left;
    last_right_ticks = cur_right;

    float dist_left_m  = (float)delta_left * METERS_PER_TICK;
    float dist_right_m = (float)delta_right * METERS_PER_TICK;
    float delta_s_m    = (dist_left_m + dist_right_m) / 2.0f;

    // Linear wheel speed measurement (z_v)
    float v_wheel_mps = delta_s_m / DT;

    // -------------------------------------------------------------
    // B. BASELINE UNFILTERED DEAD RECKONING (Drifts during slip!)
    // -------------------------------------------------------------
    raw_x_m += delta_s_m * cosf(heading_rad);

    // -------------------------------------------------------------
    // C. KALMAN FILTER PREDICTION STEP (Propagate state with IMU)
    // -------------------------------------------------------------
    ekf_x_m   += ekf_v_mps * cosf(heading_rad) * DT;
    ekf_v_mps += accel_x_mps2 * DT;
    if (ekf_v_mps < 0.0f) ekf_v_mps = 0.0f; // Forward motion

    // Propagate velocity variance: P = P + Q
    P_v += 0.05f;

    // -------------------------------------------------------------
    // D. NOVELTY 1: DYNAMIC COVARIANCE ADAPTATION
    // -------------------------------------------------------------
    float delta_v = fabsf(v_wheel_mps - ekf_v_mps);
    float R_enc;
    char *status = "[NORMAL]";

    if (delta_v > SLIP_THRESHOLD_MPS && v_wheel_mps > 0.20f) {
        status = "[SLIP! EKF INFLATED 100x -> WHEELS IGNORED]";
        R_enc = R_ENC_INFLATED; // Inflate noise 100x -> Kalman Gain drops to ~0!
    } else {
        R_enc = R_ENC_NOMINAL;  // Normal traction trust
    }

    // -------------------------------------------------------------
    // E. KALMAN FILTER MEASUREMENT UPDATE STEP
    // -------------------------------------------------------------
    float S = P_v + R_enc;
    float K = P_v / S;                      // Kalman Gain (0.0 to 1.0)
    float innovation = v_wheel_mps - ekf_v_mps;

    ekf_v_mps += K * innovation;            // Corrected velocity
    P_v        = (1.0f - K) * P_v;           // Corrected variance

    // Zero-Velocity Update (ZUPT) when wheels stop
    if (v_wheel_mps == 0.0f && fabsf(ekf_v_mps) < 0.15f) {
        ekf_v_mps = 0.0f;
    }

    // Format for printing
    int raw_cm = (int)(raw_x_m * 100.0f);
    int ekf_cm = (int)(ekf_x_m * 100.0f);
    int v_wh   = (int)(v_wheel_mps * 100.0f);
    int v_ekf  = (int)(ekf_v_mps * 100.0f);

    printf("RAW_X: %4d cm | EKF_X: %4d cm | V_WH: %3d cm/s | V_EKF: %3d cm/s | %s\r\n",
           raw_cm, ekf_cm, v_wh, v_ekf, status);

    HAL_Delay(100); // 10 Hz rate
  }
}

/* External Interrupt Callback for PC0 and PC1 */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) {
    if (GPIO_Pin == GPIO_PIN_0) {
        left_ticks_total++;
    } else if (GPIO_Pin == GPIO_PIN_1) {
        right_ticks_total++;
    }
}

static void MX_GPIO_Init(void)
{
  GPIO_InitTypeDef GPIO_InitStruct = {0};

  __HAL_RCC_GPIOC_CLK_ENABLE();
  __HAL_RCC_SYSCFG_CLK_ENABLE();
  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_GPIOB_CLK_ENABLE();

  GPIO_InitStruct.Pin = GPIO_PIN_0 | GPIO_PIN_1;
  GPIO_InitStruct.Mode = GPIO_MODE_IT_FALLING;
  GPIO_InitStruct.Pull = GPIO_PULLUP;
  HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);

  __HAL_GPIO_EXTI_CLEAR_IT(GPIO_PIN_0);
  __HAL_GPIO_EXTI_CLEAR_IT(GPIO_PIN_1);

  HAL_NVIC_SetPriority(EXTI0_IRQn, 2, 0);
  HAL_NVIC_EnableIRQ(EXTI0_IRQn);

  HAL_NVIC_SetPriority(EXTI1_IRQn, 2, 0);
  HAL_NVIC_EnableIRQ(EXTI1_IRQn);
}

void EXTI0_IRQHandler(void) {
    HAL_GPIO_EXTI_IRQHandler(GPIO_PIN_0);
}

void EXTI1_IRQHandler(void) {
    HAL_GPIO_EXTI_IRQHandler(GPIO_PIN_1);
}

