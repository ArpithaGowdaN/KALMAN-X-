static void say(const char *s)
{
  HAL_UART_Transmit(&huart2, (uint8_t*)s, strlen(s), 100);
}

static void drive(int left, int right)   /* +1 forward, -1 reverse, 0 stop */
{
  if (LEFT_INVERT)  left  = -left;
  if (RIGHT_INVERT) right = -right;
  HAL_GPIO_WritePin(L_IN1_PORT, L_IN1_PIN, left  > 0 ? GPIO_PIN_SET : GPIO_PIN_RESET);
  HAL_GPIO_WritePin(L_IN2_PORT, L_IN2_PIN, left  < 0 ? GPIO_PIN_SET : GPIO_PIN_RESET);
  HAL_GPIO_WritePin(R_IN3_PORT, R_IN3_PIN, right > 0 ? GPIO_PIN_SET : GPIO_PIN_RESET);
  HAL_GPIO_WritePin(R_IN4_PORT, R_IN4_PIN, right < 0 ? GPIO_PIN_SET : GPIO_PIN_RESET);
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */
  GPIO_InitTypeDef gi = {0};
  gi.Mode  = GPIO_MODE_OUTPUT_PP;
  gi.Pull  = GPIO_NOPULL;
  gi.Speed = GPIO_SPEED_FREQ_LOW;
  gi.Pin = GPIO_PIN_10;                           HAL_GPIO_Init(GPIOA, &gi);
  gi.Pin = GPIO_PIN_3 | GPIO_PIN_5 | GPIO_PIN_10; HAL_GPIO_Init(GPIOB, &gi);
  drive(0, 0);

  int cl = 1, cr = 1;               /* both motors start forward */
  int duty = 8;                     /* speed, 3..10 = 30..100 % */
  int step = 0;                     /* software PWM step */
  int kick = 300;                   /* full-power start, ~0.3 s */
  char msg[80];
  say("2-MOTOR DRIVE. w fwd, s back, a left, d right, x stop, z zero, +/- speed\r\n");

  /* LM393 encoders: DO -> PC0 (A5) left, PC1 (A4) right */
  gi.Mode = GPIO_MODE_INPUT;
  gi.Pull = GPIO_PULLUP;
  gi.Pin  = GPIO_PIN_0 | GPIO_PIN_1;
  HAL_GPIO_Init(GPIOC, &gi);
  uint32_t encL = 0, encR = 0, encLp = 0, encRp = 0;
  uint8_t  lPrev = HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_0);
  uint8_t  rPrev = HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_1);
  uint32_t lastEnc = HAL_GetTick();
  uint32_t edgeL = 0, edgeR = 0;      /* time of last accepted pulse, for debounce */
  /* USER CODE END 2 */


  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    uint8_t c;
    if (HAL_UART_Receive(&huart2, &c, 1, 1) == HAL_OK) {   /* also the 1 ms tick */
      int nl = cl, nr = cr, handled = 1;
      switch (c) {
        case 'w': nl =  1; nr =  1; break;
        case 's': nl = -1; nr = -1; break;
        case 'a': nl = -1; nr =  1; break;
        case 'd': nl =  1; nr = -1; break;
        case 'x': case ' ': nl = 0; nr = 0; break;
        case 'z': encL = 0; encR = 0; encLp = 0; encRp = 0; break;   /* zero the distances */
        case '+': if (duty < 10) duty++; break;
        case '-': if (duty > 3)  duty--; break;
        default: handled = 0; break;
      }
      if (handled) {
        if ((nl != 0 || nr != 0) && cl == 0 && cr == 0) kick = 300;
        cl = nl; cr = nr;
        sprintf(msg, "L=%d R=%d speed=%d\r\n", cl, cr, duty);
        say(msg);
      }
    }

    int d = (kick > 0) ? 10 : duty;
    if (kick > 0) kick--;
    int on = (step < d);
    drive(on ? cl : 0, on ? cr : 0);
    /* backup right pins D4 / D6 follow IN3 / IN4 */
    int rr = on ? (RIGHT_INVERT ? -cr : cr) : 0;
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5,  rr > 0 ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10, rr < 0 ? GPIO_PIN_SET : GPIO_PIN_RESET);
    step = (step + 1) % 10;

    /* encoder pulse counting (rising edges) */
    uint8_t l = HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_0);
    uint8_t r = HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_1);
    uint32_t nowT = HAL_GetTick();
    if (l && !lPrev && (nowT - edgeL >= 4)) { encL++; edgeL = nowT; }   /* ignore bounce < 4 ms */
    if (r && !rPrev && (nowT - edgeR >= 4)) { encR++; edgeR = nowT; }
    lPrev = l; rPrev = r;

    if (HAL_GetTick() - lastEnc >= 200) {
      lastEnc = HAL_GetTick();
      float dmL = encL * MM_PER_PULSE, dmR = encR * MM_PER_PULSE;   /* distance, mm */
      float vL  = (encL - encLp) * MM_PER_PULSE / 0.2f;             /* speed, mm/s */
      float vR  = (encR - encRp) * MM_PER_PULSE / 0.2f;
      sprintf(msg, "L=%ldmm R=%ldmm vL=%ldmm/s vR=%ldmm/s\r\n",
              (long)dmL, (long)dmR, (long)vL, (long)vR);
      say(msg);
      encLp = encL; encRp = encR;
    }
  }
  /* USER CODE END 3 */
}

