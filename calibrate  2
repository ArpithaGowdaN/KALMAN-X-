#define L_IN1_PORT GPIOA
#define L_IN1_PIN  GPIO_PIN_8    /* D7  */
#define L_IN2_PORT GPIOA
#define L_IN2_PIN  GPIO_PIN_9    /* D8  */

#define ALT_RIGHT_PINS 0         /* set 1 to use D4/D6 for IN3/IN4 instead of D2/D3 */
#if ALT_RIGHT_PINS
#define R_IN3_PORT GPIOB
