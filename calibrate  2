#endif

/* Set to 1 if that side's wheels turn the wrong way */
#define LEFT_INVERT   1
#define RIGHT_INVERT  0

#define START_SPEED   8          /* 3..10 = 30..100 % */
#define KICK_TICKS    300        /* ~0.3 s full-power start */

/* Wheel + encoder geometry: CHANGE THESE to match your rover */
#define ENC_SLOTS      20.0f     /* counted on the disc */
#define WHEEL_DIAM_MM  65.0f     /* measured wheel diameter */
#define MM_PER_PULSE   (3.14159265f * WHEEL_DIAM_MM / ENC_SLOTS)
