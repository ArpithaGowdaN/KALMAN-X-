#include "main.h"
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846f
#endif

/* Physical Constants */
#define WHEEL_RADIUS_M          0.033f   // 33 mm radius (standard 66 mm wheel)
#define ENCODER_PPR             20.0f    // 20 pulses per revolution slotted disc
#define MPU6050_ADDR            (0x68 << 1)

I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef huart2;

/* Global Tick Counters (Updated via EXTI ISR on PC0 & PC1) */
volatile uint32_t left_ticks_total  = 0;
volatile uint32_t right_ticks_total = 0;

/* Calibrated Gyro Offset */
float bias_gz = 0.0f;

/* Rover World Coordinates (Start at origin: 0, 0) */
float rover_x_m   = 0.0f;
float rover_y_m   = 0.0f;
float heading_rad = 0.0f;

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_I2C1_Init(void);

int __io_putchar(int ch) {
    HAL_UART_Transmit(&huart2, (uint8_t *)&ch, 1, 10);
    return ch;
}

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();

  printf("\r\n======================================================\r\n");
  printf("   KALMAN X: STEP 2 - DEAD RECKONING (PC0/PC1 ENCODERS)\r\n");
  printf("======================================================\r\n");

  // 1. Wake up MPU-6050
  uint8_t pwr = 0x01;
  HAL_I2C_Mem_Write(&hi2c1, MPU6050_ADDR, 0x6B, 1, &pwr, 1, 100);
  HAL_Delay(50);

  // 2. Automated 2-second Gyro Calibration on Startup
  printf("[CALIB] Keep rover still on floor for 2 seconds...\r\n");
  float sum_gz = 0.0f;
  const int SAMPLES = 200;

  for (int i = 0; i < SAMPLES; i++) {
      uint8_t buf[2];
      if (HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR, 0x47, 1, buf, 2, 100) == HAL_OK) {
          int16_t raw_gz = (int16_t)((buf[0] << 8) | buf[1]);
          sum_gz += (float)raw_gz;
      }
      HAL_Delay(10);
  }

  bias_gz = (sum_gz / SAMPLES) * (3.14159f / (180.0f * 131.0f));
  printf("[OK] Gyro calibrated! Bias = %d mrad/s\r\n\r\n", (int)(bias_gz * 1000.0f));
  printf("Push or drive rover to see live (X, Y) position!\r\n");
  printf("----------------------------------------------------\r\n");

  uint32_t last_left_ticks  = 0;
  uint32_t last_right_ticks = 0;

  // Meters traveled per single encoder slot pulse
  const float METERS_PER_TICK = (2.0f * M_PI * WHEEL_RADIUS_M) / ENCODER_PPR;

  /* Infinite loop at 10 Hz (every 100ms) */
  while (1)
  {
    // A. Read Gyro-Z and integrate Heading
    uint8_t gbuf[2];
    if (HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR, 0x47, 1, gbuf, 2, 100) == HAL_OK) {
        int16_t raw_gz = (int16_t)((gbuf[0] << 8) | gbuf[1]);
        float gz_cal = ((float)raw_gz * (3.14159f / (180.0f * 131.0f))) - bias_gz;

        // Integrate heading (dt = 0.1s)
        heading_rad += gz_cal * 0.1f;

        // Wrap angle between [-PI, +PI]
        if (heading_rad > M_PI)  heading_rad -= (2.0f * M_PI);
        if (heading_rad < -M_PI) heading_rad += (2.0f * M_PI);
    }

    // B. Read Encoder Pulses and calculate distance in this step
    uint32_t cur_left  = left_ticks_total;
    uint32_t cur_right = right_ticks_total;

    uint32_t delta_left  = cur_left - last_left_ticks;
    uint32_t delta_right = cur_right - last_right_ticks;

    last_left_ticks  = cur_left;
    last_right_ticks = cur_right;

    float dist_left_m  = (float)delta_left * METERS_PER_TICK;
    float dist_right_m = (float)delta_right * METERS_PER_TICK;

    // Average forward displacement in this 100ms step
    float delta_s = (dist_left_m + dist_right_m) / 2.0f;

    // C. Dead Reckoning Coordinate Update:
    rover_x_m += delta_s * cosf(heading_rad);
    rover_y_m += delta_s * sinf(heading_rad);

    float speed_mps = delta_s / 0.1f;

    // Format for integer printing
    int x_cm = (int)(rover_x_m * 100.0f);
    int y_cm = (int)(rover_y_m * 100.0f);
    int head_deg = (int)(heading_rad * (180.0f / M_PI));
    int spd_cm = (int)(speed_mps * 100.0f);

    printf("POSE -> X: %4d cm | Y: %4d cm | HEADING: %3d deg | SPEED: %2d cm/s (L_ticks:%lu, R_ticks:%lu)\r\n",
           x_cm, y_cm, head_deg, spd_cm, cur_left, cur_right);

    HAL_Delay(100); // 10 Hz loop
  }
}

/* External Interrupt Callback for PC0 and PC1 */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) {
    if (GPIO_Pin == GPIO_PIN_0) {
        left_ticks_total++;
    } else if (GPIO_Pin == GPIO_PIN_1) {
        right_ticks_total++;
    }
}

static void MX_GPIO_Init(void)
{
  GPIO_InitTypeDef GPIO_InitStruct = {0};

  __HAL_RCC_GPIOC_CLK_ENABLE();
  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_GPIOB_CLK_ENABLE();

  // Configure PC0 (Left Encoder) and PC1 (Right Encoder) as EXTI Falling Edge
  GPIO_InitStruct.Pin = GPIO_PIN_0 | GPIO_PIN_1;
  GPIO_InitStruct.Mode = GPIO_MODE_IT_FALLING;
  GPIO_InitStruct.Pull = GPIO_PULLUP;
  HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);

  // Enable Interrupts in NVIC
  HAL_NVIC_SetPriority(EXTI0_IRQn, 2, 0);
  HAL_NVIC_EnableIRQ(EXTI0_IRQn);

  HAL_NVIC_SetPriority(EXTI1_IRQn, 2, 0);
  HAL_NVIC_EnableIRQ(EXTI1_IRQn);
}

void EXTI0_IRQHandler(void) {
    HAL_GPIO_EXTI_IRQHandler(GPIO_PIN_0);
}

void EXTI1_IRQHandler(void) {
    HAL_GPIO_EXTI_IRQHandler(GPIO_PIN_1);
}

